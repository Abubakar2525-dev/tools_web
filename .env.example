# Canonical origin used for canonical URLs, sitemap, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com
# Set to "production" ONLY on the live deployment; anything else serves a disallow-all robots.txt.
NEXT_PUBLIC_SITE_ENV=production

# Internal URL of the FastAPI service. The browser never calls this directly;
# Next.js proxies /api/contact to it so the public UI contract stays unchanged.
PYTHON_API_URL=http://127.0.0.1:8000

# Python API contact delivery (configure at least one, otherwise the form reports "not sent"):
# 1) Generic webhook (Slack workflow, Zapier, Make, CRM endpoint) receiving JSON
CONTACT_WEBHOOK_URL=
# 2) Email via Resend HTTP API
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="Website <noreply@yourdomain.com>"
